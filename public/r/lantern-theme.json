{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "lantern-theme",
  "title": "Lantern theme",
  "description": "Lantern colors, fonts, block shadows, the grid pattern and the pulse and blink animations.",
  "cssVars": {
    "theme": {
      "font-sans": "var(--font-dm-sans, \"DM Sans\"), ui-sans-serif, system-ui, sans-serif",
      "font-display": "var(--font-space-grotesk, \"Space Grotesk\"), ui-sans-serif, sans-serif",
      "shadow-block": "12px 14px 0 var(--block-shadow)",
      "shadow-block-sm": "6px 7px 0 var(--block-shadow)"
    },
    "light": {
      "background": "#111614",
      "foreground": "#eeeade",
      "card": "#1a211e",
      "card-foreground": "#eeeade",
      "popover": "#161d1a",
      "popover-foreground": "#eeeade",
      "primary": "#f5a665",
      "primary-foreground": "#1b241b",
      "secondary": "#202823",
      "secondary-foreground": "#eeeade",
      "muted": "#1a211e",
      "muted-foreground": "#96a399",
      "accent": "#263b30",
      "accent-foreground": "#eeeade",
      "destructive": "#e0715f",
      "destructive-foreground": "#1b241b",
      "success": "#9bba86",
      "success-foreground": "#111614",
      "warning": "#e8c98a",
      "warning-foreground": "#1b241b",
      "info": "#8fb3c9",
      "border": "#303b34",
      "input": "#495347",
      "ring": "#f5a665",
      "terminal": "#101b17",
      "terminal-bar": "#354832",
      "terminal-border": "#687357",
      "terminal-foreground": "#c6d4b8",
      "block-shadow": "#1e271c",
      "grid-line": "rgba(174, 196, 165, 0.05)",
      "chart-1": "#f5a665",
      "chart-2": "#9bba86",
      "chart-3": "#8fb3c9",
      "chart-4": "#e8c98a",
      "chart-5": "#e0715f",
      "sidebar": "#141a17",
      "sidebar-foreground": "#eeeade",
      "sidebar-primary": "#f5a665",
      "sidebar-primary-foreground": "#1b241b",
      "sidebar-accent": "#202823",
      "sidebar-accent-foreground": "#eeeade",
      "sidebar-border": "#303b34",
      "sidebar-ring": "#f5a665",
      "radius": "0.3125rem"
    },
    "dark": {
      "background": "#111614",
      "foreground": "#eeeade",
      "card": "#1a211e",
      "card-foreground": "#eeeade",
      "popover": "#161d1a",
      "popover-foreground": "#eeeade",
      "primary": "#f5a665",
      "primary-foreground": "#1b241b",
      "secondary": "#202823",
      "secondary-foreground": "#eeeade",
      "muted": "#1a211e",
      "muted-foreground": "#96a399",
      "accent": "#263b30",
      "accent-foreground": "#eeeade",
      "destructive": "#e0715f",
      "destructive-foreground": "#1b241b",
      "success": "#9bba86",
      "success-foreground": "#111614",
      "warning": "#e8c98a",
      "warning-foreground": "#1b241b",
      "info": "#8fb3c9",
      "border": "#303b34",
      "input": "#495347",
      "ring": "#f5a665",
      "terminal": "#101b17",
      "terminal-bar": "#354832",
      "terminal-border": "#687357",
      "terminal-foreground": "#c6d4b8",
      "block-shadow": "#1e271c",
      "grid-line": "rgba(174, 196, 165, 0.05)",
      "chart-1": "#f5a665",
      "chart-2": "#9bba86",
      "chart-3": "#8fb3c9",
      "chart-4": "#e8c98a",
      "chart-5": "#e0715f",
      "sidebar": "#141a17",
      "sidebar-foreground": "#eeeade",
      "sidebar-primary": "#f5a665",
      "sidebar-primary-foreground": "#1b241b",
      "sidebar-accent": "#202823",
      "sidebar-accent-foreground": "#eeeade",
      "sidebar-border": "#303b34",
      "sidebar-ring": "#f5a665",
      "radius": "0.3125rem"
    }
  },
  "css": {
    "@utility bg-grid": {
      "background-image": "linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px)",
      "background-size": "20px 20px"
    },
    "@keyframes lantern-pulse": {
      "50%": {
        "opacity": "0.35"
      }
    },
    "@keyframes lantern-blink": {
      "50%": {
        "opacity": "0"
      }
    },
    "@utility animate-lantern-pulse": {
      "animation": "lantern-pulse 2.4s ease-in-out infinite"
    },
    "@utility animate-lantern-blink": {
      "animation": "lantern-blink 1.1s steps(1) infinite"
    }
  },
  "type": "registry:theme"
}